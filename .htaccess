# Forzar HTTPS (independiente del dominio: seguirá funcionando al cambiarlo)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# En el hosting, servir la versión PHP (index.html es solo el demo estático de GitHub Pages)
DirectoryIndex index.php index.html

# No listar directorios
Options -Indexes

# Bloquear archivos sensibles (el .env con las credenciales, sobre todo)
<FilesMatch "^(\.env.*|schema\.sql|README-DEPLOY\.md)$">
  Require all denied
</FilesMatch>
